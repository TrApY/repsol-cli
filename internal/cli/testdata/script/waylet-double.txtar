env REPSOL_LOGIN_TOKEN=fake-token
env REPSOL_GMID=fake-gmid
exec repsol address set 'Calle Falsa 1, Pueblo' --floor 2 --door B
fake check order

# Without --wait the first command prints the link and exits. Repsol has no
# order until the owner pays, so the history cannot tell the next run.
exec repsol order create --pay waylet
stdout '"payment_id": "fake-payment-1"'
fake count /api/cart 1

# A second run, with either payment method, creates nothing.
! exec repsol --error-format json order create --pay waylet
stderr '"code":"payment_pending"'
stderr '"exit_code":8'
stderr 'repsol order payment fake-payment-1 --wait'
stderr '--abandon-payment'
! exec repsol --error-format json order create --pay delivery
stderr '"code":"payment_pending"'
! exec repsol --error-format json order create
stderr '"code":"payment_pending"'
fake count /api/cart 1
fake count /api/waylet-payment/url 1
fake count /api/order 0
fake count /api/solicitude 0

# A dry run says the same and changes nothing.
! exec repsol --error-format json order create --pay waylet --dry-run
stderr '"code":"payment_pending"'

# Checking the payment keeps it open while it is unpaid.
exec repsol order payment fake-payment-1
stdout '"payment_status": "awaiting_payment"'
! exec repsol --error-format json order create --pay waylet
stderr '"code":"payment_pending"'

# --force is about the order history: it does not let go of a payment that may
# have been paid. Giving the payment up is a separate, explicit decision.
! exec repsol --error-format json order create --pay waylet --force
stderr '"code":"payment_pending"'
fake count /api/cart 1
exec repsol order create --pay waylet --abandon-payment
stdout '"payment_id": "fake-payment-2"'
stdout '"notices"'
stdout 'forgotten'
fake count /api/cart 2

# The newest payment is the open one.
! exec repsol --error-format json order create --pay waylet
stderr 'repsol order payment fake-payment-2 --wait'

# Once it is paid, the payment itself refuses the next order, on its own word.
fake waylet pay fake-payment-2
! exec repsol --error-format json order create --pay waylet
stderr '"code":"pending_order"'
fake count /api/cart 2

# The first payment was abandoned, so only the second is tracked; the paid
# order answers on the payment's own word, naming the order and its date.
! exec repsol --error-format json order create
stderr '"code":"pending_order"'
stderr '800000000000000003'
