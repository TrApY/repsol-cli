env REPSOL_LOGIN_TOKEN=fake-token
env REPSOL_GMID=fake-gmid
exec repsol address set 'Calle Falsa 1, Pueblo' --floor 2 --door B

# The agency does not accept Waylet.
fake check order
fake waylet off
! exec repsol --error-format json order create --pay waylet
stderr '"code":"waylet_unavailable"'
stderr '"exit_code":8'
stderr '--pay delivery'
fake count /api/cart 0
fake count /api/cart/check 0

# A request (SOLICITUDE) cannot be paid online even when the agency takes Waylet.
fake waylet on
fake check solicitude
! exec repsol --error-format json order create --pay waylet
stderr '"code":"waylet_unavailable"'
fake count /api/cart 0
fake count /api/solicitude 0
